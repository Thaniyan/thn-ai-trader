{
  "name": "thn-ai-trader",
  "version": "6.0.0",
  "description": "THN AI Trader - professional bilingual AI-powered trading workstation with automated copilot, clear technical drawing chart, dedicated SK/SMC analysis map, watchlist patrol, risk governance, journaling and reports.",
  "type": "module",
  "engines": {
    "node": ">=24.5"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node --check server.js && node --check public/app.js",
    "lint": "node tests/check-syntax.mjs",
    "check": "node --check server.js && node --check public/app.js",
    "test": "node --test tests/*.test.mjs && node tests/run-system.mjs",
    "test:browser": "python tests/browser.test.py",
    "test:load": "node tests/load.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.27.0"
  }
}
