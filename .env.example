PORT=3000
THN_DATA_DIR=
# Local loopback sandbox only. VERCEL always disables it.
THN_LOCAL_PAPER=0
# Optional local-only generative adapter. Disabled by default; never public credentials.
THN_AI_ENABLED=0
THN_AI_AUTH_TOKEN=
OPENAI_API_KEY=
THN_AI_MODEL=
THN_AI_MAX_REQUESTS=1
THN_AI_MAX_OUTPUT_TOKENS=400
THN_AI_TOTAL_TOKEN_CEILING=4000

# Existing fixed OpenAI adapter is retained, disabled above. Choose ollama explicitly
# for the local pilot. Never configure this on a public/hosted instance.
THN_AI_PROVIDER=openai
THN_AI_OLLAMA_URL=http://127.0.0.1:11434
THN_AI_CONTEXT_TOKENS=4096
THN_AI_TIMEOUT_MS=12000
